{
  "name": "github-issue-investigator",
  "version": "0.1.0",
  "private": true,
  "engines": { "node": ">=22 <25" },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "next typegen && tsc --noEmit",
